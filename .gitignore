# Release-repo .gitignore (Goal-to-Spec Kit)
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db

# Visual-QA screenshot artifacts (untracked per UX standard)
.playwright-mcp/

# Local working notes (not for public distribution)
PUBLISHING.md

